# Copy to backend/.env on your server
PORT=4000
HOST=0.0.0.0
PUBLIC_URL=http://dirshay.com:4000
CORS_ORIGINS=http://dirshay.com:4000,http://dirshay.com,https://dirshay.com,http://www.dirshay.com
CORS_ALLOW_ALL=false
MONGODB_URI=mongodb://127.0.0.1:27017/safefare
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
DEFAULT_COMPANY_NAME=My Bus Company
SMS_ENABLED=false
