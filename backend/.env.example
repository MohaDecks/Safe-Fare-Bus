PORT=4000
# Production server: 127.0.0.1 (nginx only). Local dev: 0.0.0.0
HOST=0.0.0.0
# Public URL clients use (domain or IP)
PUBLIC_URL=https://dirshay.com
# Comma-separated browser origins (portal, web clients)
CORS_ORIGINS=https://dirshay.com,http://dirshay.com,https://www.dirshay.com,http://localhost:4000
# Set true only for local dev if you need any origin
CORS_ALLOW_ALL=false
MONGODB_URI=mongodb://127.0.0.1:27017/safefare
JWT_SECRET=change-me-in-production-use-long-random-string
DEFAULT_COMPANY_NAME=My Bus Company
# Set true when SMS provider is connected (hides OTP from app response)
SMS_ENABLED=false
# Play Store reviewer login (static OTP, always works)
REVIEWER_PHONES=0911111111
REVIEWER_OTP=123456
